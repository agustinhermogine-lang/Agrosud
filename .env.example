PORT=3000
HOST=0.0.0.0
MARKET_REFRESH_MS=15000
MARKET_CACHE_MS=15000

# Mercado en tiempo real por defecto: Yahoo Finance Chart API.
# Reemplaza {symbol} por el ticker del futuro, por ejemplo ZC=F, ZS=F, ZW=F.
MARKET_API_URL=https://query1.finance.yahoo.com/v8/finance/chart/{symbol}
MARKET_API_KEY=

# USDA FAS Open Data / PSD.
# Gratis, pero requiere una API key de API.Data.Gov.
USDA_API_KEY=
USDA_MARKET_YEAR=2026

# IDs del endpoint web demorado de CME usados por la terminal.
# ZC/ZS/ZW/ZL vienen configurados. Si CME cambia estos IDs, se pueden actualizar acá.
CME_PRODUCT_ZC=300
CME_PRODUCT_ZS=320
CME_PRODUCT_ZW=323
CME_PRODUCT_ZL=312
CME_PRODUCT_ZM=310
CME_PRODUCT_ZO=
CME_PRODUCT_SOR=
CME_PRODUCT_BAR=

# Símbolos para la API externa opcional. Se usan para Yahoo Finance / mercado realtime.
MARKET_SYMBOL_ZC=ZC=F
MARKET_SYMBOL_ZS=ZS=F
MARKET_SYMBOL_ZW=ZW=F
MARKET_SYMBOL_ZM=ZM=F
MARKET_SYMBOL_ZL=ZL=F
MARKET_SYMBOL_ZO=ZO=F
MARKET_SYMBOL_SOR=SOR=F
MARKET_SYMBOL_BAR=BAR=F

# CME DataMine: recomendado para settlements históricos contractuales estables.
# Requiere API ID / password y entitlement al dataset correspondiente.
CME_DATAMINE_API_ID=
CME_DATAMINE_API_PASSWORD=

# A3 / Primary REST: valores provistos por un agente habilitado.
# El entorno reMarkets es de pruebas, no representa precios del mercado real.
A3_API_BASE_URL=
A3_USERNAME=
A3_PASSWORD=
A3_AUTH_TOKEN=
# Opcional: símbolos exactos separados por coma; por defecto filtra soja, maíz y trigo.
A3_SYMBOLS=
